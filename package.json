{
  "name": "second-opinion",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "selftest": "npm run -w @so/engine selftest",
    "golden:diff": "npm run -w @so/engine golden:diff",
    "pages": "npm run -w @so/static build",
    "validate": "npm run -w @so/validate validate",
    "check": "npm run selftest && npm run pages && npm run validate",
    "e2e:chat": "npm run -w @so/validate e2e:chat",
    "web:dev": "npm run -w @so/web dev",
    "web:build": "npm run -w @so/web build",
    "web:start": "npm run -w @so/web start",
    "audit": "npm run -w @so/engine audit; E=$?; npm run -w @so/web audit; W=$?; exit $((E|W))",
    "audit:engine": "npm run -w @so/engine audit --",
    "audit:web": "npm run -w @so/web audit --"
  }
}
