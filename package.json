{
  "name": "second-opinion",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "selftest": "npm run -w @so/engine selftest",
    "golden:diff": "npm run -w @so/engine golden:diff",
    "pages": "npm run -w @so/static build",
    "validate": "npm run -w @so/validate validate",
    "check": "npm run selftest && npm run pages && npm run validate"
  }
}
