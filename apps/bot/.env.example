# Telegram-бот Second opinion (apps/bot). Скопируйте в apps/bot/.env и выставьте права: chmod 600 apps/bot/.env.
# На heidi файл читает юнит second-opinion-bot (EnvironmentFile); на Mac — npm run -w @so/bot dev (tsx --env-file=.env).
# Значения секретов в чат и в git не попадают.

# Токен и @username бота из BotFather (без «@»). getMe сверяется с TG_BOT_USERNAME: чужой токен — бот не стартует.
TG_BOT_TOKEN=
TG_BOT_USERNAME=

# Соль псевдонимов (коды доступа = HMAC(соль, chat_id)): openssl rand -base64 32. Сменить соль = сменить все коды доступа.
SO_TG_SALT=
# Ключ бота для сервера — тот же, что SO_BOT_KEY в apps/web/.env: openssl rand -base64 32.
SO_BOT_KEY=

# Коды доступа через запятую: "" — никто, "*" — все (публичный запуск — только при SO_DAILY_BUDGET_USD > 0 на сервере).
SO_TG_ALLOW=
# Ходов в сутки (МСК) на код доступа; 0 — без лимита.
SO_TG_DAILY=60
# Ходов одновременно на весь бот.
SO_TG_CONCURRENCY=4
# Разговоров в памяти (сверх — вытесняется самый давний).
SO_TG_MAX_CHATS=300
# Адрес сайта для кнопки «Открыть на сайте» под отчётом; пусто — кнопки нет.
SO_SITE_URL=
# 0 — бот не опрашивает Telegram (heartbeat пишет); выключатель §7 плана WP-TG.
SO_TG=1

# Адрес сервера решений (только loopback http; туда уходит SO_BOT_KEY). По умолчанию — http://127.0.0.1:3000.
# SO_WEB_URL=http://127.0.0.1:3000

# ТОЛЬКО e2e: фейковый Bot API на loopback (http, 127.0.0.1 или localhost, явный порт). В прод-.env этой строки нет:
# при NODE_ENV=production бот с ней не стартует.
# TG_API_ROOT=http://127.0.0.1:8081
