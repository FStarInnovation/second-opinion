# Скопируй в .env (файл в .gitignore). Ключи — только здесь, никогда в чате и файлах репозитория.
# Вариант A (целевой): OpenRouter — Haiku 5.5 + fallback GPT-6 Luna + Jev на одном ключе.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_FALLBACK_MODEL=openai/gpt-6-luna
# Вариант B: Claude API напрямую (console.anthropic.com) — Haiku 5.5 без fallback; Jev недоступен, маршрутизация по правилам.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Если заданы оба ключа — какой провайдер использовать: openrouter | anthropic (по умолчанию openrouter).
LLM_PROVIDER=
# Без ключей приложение работает в MOCK-режиме со скриптовыми сценариями.
# Jev (TypeSafe) — маршрутизация реплик и разбор «обещали». Два варианта доступа:
#   прямой API TypeSafe (ключ apikey_… из личного кабинета TypeSafe) — приоритетный;
#   или через OpenRouter Decisions API на том же OPENROUTER_API_KEY.
TYPESAFE_API_KEY=
JEV_PROVIDER=            # typesafe | openrouter — принудительно, если есть оба ключа
JEV_ENABLED=1
JEV_MODEL=jev-latest     # для TypeSafe; для OpenRouter — JEV_MODEL_OPENROUTER=typesafe/jev-1.13
JEV_THRESHOLD=0.8
JEV_TIMEOUT_MS=2500
# Режимы
SO_CHAT=1            # 0 — выключить ассистентный слой (остаётся прямой путь без LLM)
SO_MESSAGE_LIMIT=20  # реплик пользователя на сессию
SO_DAILY_BUDGET_USD=2  # дневной лимит расхода на модели для открытого стенда (сутки по МСК); 0 — без лимита
SO_OFFLINE=0         # 1 — движок работает по golden-снимкам без ISS (тесты)
MOCK_LLM=0           # 1 — скриптовая модель вместо OpenRouter (тесты без ключа)
